# AeroTwin — UAV Engine Digital-Twin Health Monitoring Agent
# SIH 2026 — SIH26054

# ============ Groq LLM ============
GROQ_API_KEY=your_groq_api_key_here
# Groq retires models regularly; check https://console.groq.com/docs/deprecations
GROQ_MODEL=openai/gpt-oss-120b

# ============ Database ============
POSTGRES_USER=aerotwin
POSTGRES_PASSWORD=aerotwin_secret_2026
POSTGRES_DB=aerotwin
DATABASE_URL=postgresql+asyncpg://aerotwin:aerotwin_secret_2026@timescaledb:5432/aerotwin

# ============ Redis ============
REDIS_URL=redis://redis:6379/0

# ============ JWT Auth ============
JWT_SECRET_KEY=aerotwin-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============ Simulator ============
SIMULATOR_INTERVAL_MS=1000
SIMULATOR_ENABLED=true

# ============ App ============
APP_ENV=development
LOG_LEVEL=INFO

